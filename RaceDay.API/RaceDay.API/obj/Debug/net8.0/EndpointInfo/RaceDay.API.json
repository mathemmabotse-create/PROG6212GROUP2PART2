  "components": {
    "schemas": {
      "Category": {
        "required": [
          "categoryName"
        ],
        "type": "object",
        "properties": {
          "categoryID": {
            "type": "integer",
            "format": "int32"
          },
          "categoryName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "minimumAge": {
            "maximum": 120,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "maximumAge": {
            "maximum": 120,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "eventCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventCategory"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Event": {
        "required": [
          "description",
          "eventDate",
          "eventName",
          "eventType",
          "location",
          "status"
        ],
        "type": "object",
        "properties": {
          "eventID": {
            "type": "integer",
            "format": "int32"
          },
          "eventName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "location": {
            "minLength": 1,
            "type": "string"
          },
          "capacity": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "distance": {
            "maximum": 10000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "eventType": {
            "minLength": 1,
            "pattern": "^(RUN|WALK|CYCLE)$",
            "type": "string"
          },
          "status": {
            "minLength": 1,
            "type": "string"
          },
          "organiserID": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "eventCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventCategory"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EventCategory": {
        "type": "object",
        "properties": {
          "eventCategoryID": {
            "type": "integer",
            "format": "int32"
          },
          "eventID": {
            "type": "integer",
            "format": "int32"
          },
          "categoryID": {
            "type": "integer",
            "format": "int32"
          },
          "event": {
            "$ref": "#/components/schemas/Event"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          }
        },
        "additionalProperties": false
      },
      "User": {
        "required": [
          "email",
          "fullName",
          "passwordHash",
          "phone",
          "role"
        ],
        "type": "object",
        "properties": {
          "userID": {
            "type": "integer",
            "format": "int32"
          },
          "fullName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "passwordHash": {
            "minLength": 1,
            "type": "string"
          },
          "phone": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "pattern": "^(ORGANISER|PARTICIPANT)$",
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
